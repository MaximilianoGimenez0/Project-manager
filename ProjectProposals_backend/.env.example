POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CambiaEstaClaveSuperSeguraEnProduccion2026!
POSTGRES_DB=projectapproval
TZ=UTC

# Bind to 127.0.0.1 on VPS to prevent public database port exposure.
# Connect via SSH tunnel: ssh -L 5532:localhost:5532 user@vps
DB_PORT_BINDING=127.0.0.1:5532

ASPNETCORE_ENVIRONMENT=Production
INCLUDE_ERROR_DETAIL=false
ENABLE_SWAGGER=true

# Bind to 127.0.0.1 on VPS so only the reverse proxy (Nginx/Caddy) serves requests
API_PORT_BINDING=127.0.0.1:8080

# Symmetric signing key requires minimum 32 characters
JWT_SECRET_KEY=GeneraUnaClaveCriptograficaMuySeguraDeAlMenos32Caracteres2026!
JWT_ISSUER=ProjectProposalsApi
JWT_AUDIENCE=ProjectProposalsClient
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
