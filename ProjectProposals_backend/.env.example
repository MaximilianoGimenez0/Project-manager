# ==============================================================================
# Variables de Entorno - Project Proposals Backend
# Copiar este archivo como '.env' antes de levantar en el VPS:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=CambiaEstaClaveSuperSeguraEnProduccion2026!
POSTGRES_DB=projectapproval
TZ=UTC

# En el VPS, atar a 127.0.0.1 evita que el puerto 5532 quede abierto a escaneos de internet.
# Para conectarte desde DBeaver/pgAdmin, haz un túnel SSH: ssh -L 5532:localhost:5532 usuario@vps
DB_PORT_BINDING=127.0.0.1:5532

# ------------------------------------------------------------------------------
# Backend Web API .NET 8
# ------------------------------------------------------------------------------
# 'Production' o 'Development'
ASPNETCORE_ENVIRONMENT=Production

# Detalle de errores de EF Core (false en producción)
INCLUDE_ERROR_DETAIL=false

# Permitir Swagger UI en el VPS (true si quieres probar la documentación en https://tu-dominio/swagger)
ENABLE_SWAGGER=true

# En el VPS, atar a 127.0.0.1 asegura que solo el Reverse Proxy (Nginx/Caddy) atienda las peticiones
API_PORT_BINDING=127.0.0.1:8080

# ------------------------------------------------------------------------------
# Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
# Clave criptográfica simétrica de al menos 32 caracteres
JWT_SECRET_KEY=GeneraUnaClaveCriptograficaMuySeguraDeAlMenos32Caracteres2026!
JWT_ISSUER=ProjectProposalsApi
JWT_AUDIENCE=ProjectProposalsClient
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
